# Environment variable overrides for core-llm-inference.
# Copy to .env and fill in values; never commit .env to source control.

# Engine & model
INFERENCE_ENGINE=sglang
INFERENCE_MODEL=Qwen/Qwen2.5-7B-Instruct
INFERENCE_MODEL_SIZE_GB=14.0

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=30000
SERVER_TIMEOUT=300

# GPU
GPU_TYPE=rtx-5080
GPU_PEAK_BANDWIDTH_GBPS=960.0

# Benchmark
BENCHMARK_NUM_QUERIES=10
BENCHMARK_CONCURRENCY=1
BENCHMARK_WARMUP=false
BENCHMARK_CATEGORIES=
BENCHMARK_OUTPUT_DIR=results
BENCHMARK_SEED=42

# Monitoring
PROMETHEUS_PUSHGATEWAY=http://localhost:9091
ENABLE_GPU_METRICS=true
LOG_JSONL=true
